# Copy this file to ".env" and fill it in.

# Staff PIN (4–12 digits). Don't use 1234 / 0000.
STAFF_PIN=

# Folder on the NAS that holds the year folders (2025, 2026 …).
# Find it in the UGOS Pro Files app → right-click the folder → Properties / Details.
# Example: /volume1/Photos
PHOTOS_PATH=/volume1/Photos

# Folder on the NAS where the app COPIES the RAW files of each client's selection:
#   <PROJECTS_PATH>/<year>/<week>/<client name>/
# This is the only place the app writes photo files. Create it from the studio PC first
# (see README → Folder permissions). Example: /volume1/Projects
PROJECTS_PATH=

# Where the app keeps its own data (selections + thumbnail cache). ./data = inside this project folder.
DATA_PATH=./data

# Port clients open on the tablet: http://192.168.101.153:8080
APP_PORT=8080

# Package sizes shown as quick buttons when starting a session (staff can also type any number).
PACKAGE_SIZES=10,20,30,50

# Price per extra picture beyond the package, in whole rand (staff can change it per session).
EXTRA_IMAGE_PRICE=250

# Week folders clients can browse must end with this word.
BACKUP_SUFFIX=backup

TZ=Africa/Johannesburg

# Advanced (normally leave empty): run the app as this NAS user/group id.
# Empty = use the owner of the projects folder.
PUID=
PGID=
